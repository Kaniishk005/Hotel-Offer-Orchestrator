{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Temporal-orchestrated hotel offer aggregation with Redis price filtering",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration:redis": "vitest run --config vitest.redis.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/common": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
